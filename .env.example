# Rust API (backend/)
DATABASE_URL=postgres://gitop:gitop@localhost:5432/gitop
API_PORT=8080

# Go gateway (gateway/) — lib/pq needs the sslmode flag for local Postgres
# DATABASE_URL=postgres://gitop:gitop@localhost:5432/gitop?sslmode=disable
API_UPSTREAM=http://localhost:8080
GATEWAY_PORT=8081
GATEWAY_ALLOW_ORIGIN=*

# Frontend dev server proxy target
GATEWAY_URL=http://localhost:8081
